# 1. Initialize environment & credentials
touch .gitignore

export AWS_ACCESS_KEY_ID="<lab_key>"
export AWS_SECRET_ACCESS_KEY="<lab_secret>"

# Pull the lab's SSH key name automatically
export TF_VAR_ssh_key_name=$(aws ec2 describe-key-pairs --query "KeyPairs[0].KeyName" --output text)

# [Action Required]: Download private key from the lab portal into this directory
chmod 400 ${TF_VAR_ssh_key_name}.pem

may have to create key pair: ssh-keygen -t rsa -b 2048 -f ~/.ssh/<your_key_name>

